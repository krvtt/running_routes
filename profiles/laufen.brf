# Laufrouten - BRouter-Profil zum Laufen
#
# Kostenfaktor 1.0 = Weg im Gruenen oder am Wasser. Hoehere Werte machen einen Abschnitt
# entsprechend "teurer"; Knotenkosten (Ampel, Querung) sind in Metern Umweg angegeben.
# Rangfolge: Weg im Gruenen < sonstiger Weg < Gehweg/Radweg an der Strasse ~ ruhige Strasse
# < Hauptstrasse. Gruen und Wasser wirken vor allem auf Wege, kaum auf Strassen am Parkrand.
# Alle mit %name% markierten Werte lassen sich pro Anfrage per URL-Parameter
# "profile:<name>=<wert>" ueberschreiben (so setzt die App die Trainingsarten um).

---context:global

assign validForFoot = true
assign waypointCatchingRange = 400              # Stuetzpunkte im Wasser o. Ae. bis 400 m an den naechsten Weg ziehen
assign correctMisplacedViaPoints = true         # Stichwege zu Stuetzpunkten (hin und zurueck) entfernen,
assign correctMisplacedViaPointsDistance = 400  # sofern sie einfache Strecke kuerzer als 400 m sind

assign green_pref    = 0.7   # %green_pref% | Aufschlag fuer Wege ohne Gruen/Wasser (0 = egal) | number
assign road_base     = 1.8   # %road_base% | Kostenfaktor ruhige Strasse und Gehweg an der Strasse | number
assign big_road      = 1.0   # %big_road% | Multiplikator fuer den Aufschlag grosser Strassen | number
assign noise_weight  = 0.4   # %noise_weight% | Aufschlag fuer Laerm | number
assign route_bonus   = 0.15  # %route_bonus% | Rabatt fuer Wege auf markierten Wander-/Fussrouten | number
assign signal_cost   = 100   # %signal_cost% | Ampel in Metern Umweg-Aequivalent | number
assign crossing_unit = 25    # %crossing_unit% | ungesicherte Querung Haupt-/Nebenstrasse je Klasse 1-6 | number
assign zebra_cost    = 20    # %zebra_cost% | Zebrastreifen | number
assign turn_cost     = 5     # %turn_cost% | Richtungswechsel 90 Grad in Metern (wirkt an jeder Biegung!) | number
assign steps_factor  = 3     # %steps_factor% | Kostenfaktor Treppen | number
assign paved_pref    = 0     # %paved_pref% | -1 weich bevorzugen, 0 egal, 1 glatt bevorzugen | number

assign uphillcost   = 0
assign downhillcost = 0

---context:way

assign footaccess =
       if foot=no|private|use_sidepath then false
       else if foot=yes|designated|permissive|destination then true
       else if access=no|private then false
       else if motorroad=yes then false
       else if highway=motorway|motorway_link|construction|proposed|platform|raceway|abandoned|busway then false
       else true

# Gruen/Wasser als Anteil 0..1 aus den BRouter-Schaetzklassen (Parks, Waelder, Kleingaerten, Ufer)
assign forest_s =
       switch estimated_forest_class=6 1
       switch estimated_forest_class=5 0.85
       switch estimated_forest_class=4 0.7
       switch estimated_forest_class=3 0.45
       switch estimated_forest_class=2 0.25
       switch estimated_forest_class=1 0.1 0

assign river_s =
       switch estimated_river_class=6 1
       switch estimated_river_class=5 0.85
       switch estimated_river_class=4 0.7
       switch estimated_river_class=3 0.45
       switch estimated_river_class=2 0.25
       switch estimated_river_class=1 0.1 0

assign green = max forest_s river_s
assign no_green = sub 1 green

assign noise_s =
       switch estimated_noise_class=6 1
       switch estimated_noise_class=5 0.85
       switch estimated_noise_class=4 0.65
       switch estimated_noise_class=3 0.45
       switch estimated_noise_class=2 0.25
       switch estimated_noise_class=1 0.1 0

assign on_route =
       or route_hiking_iwn=yes or route_hiking_nwn=yes or route_hiking_rwn=yes or route_hiking_lwn=yes
       or route_foot_nwn=yes or route_foot_rwn=yes route_foot_lwn=yes

# separat kartierte Gehwege und Ueberwege gehoeren zur Strasse, nicht in den Park
assign is_sidewalk = footway=sidewalk|crossing
assign is_trail = and highway=path|track|bridleway|footway|pedestrian not is_sidewalk

assign road_cost =
       if highway=living_street then 1.4
       else if highway=residential|service|unclassified|road then road_base
       else if highway=tertiary|tertiary_link then add road_base 0.5
       else if highway=secondary|secondary_link then add road_base multiply big_road 1.2
       else if highway=primary|primary_link then add road_base multiply big_road 2.2
       else if highway=trunk|trunk_link then add road_base multiply big_road 3.5
       else add road_base 0.2

assign base_cost =
       if highway=steps then steps_factor
       else if is_trail then
         ( add 1.0 multiply green_pref no_green )
       else if highway=cycleway then
         ( add ( if foot=yes|designated then 1.1 else 1.4 ) multiply green_pref no_green )
       else if is_sidewalk then
         ( add road_base multiply 0.5 multiply green_pref no_green )
       else
         ( add road_cost multiply 0.5 multiply green_pref no_green )

assign route_disc = if and on_route is_trail then route_bonus else 0

assign is_smooth = surface=asphalt|paved|concrete|paving_stones
assign is_soft   = surface=compacted|fine_gravel|ground|dirt|earth|gravel|unpaved|grass|wood
assign is_bad    = surface=mud|sand|pebblestone|sett|cobblestone|rock|stone|clay

assign surface_f =
       if is_bad then 1.3
       else if greater paved_pref 0 then ( if is_soft then add 1 multiply paved_pref 0.3 else 1 )
       else if lesser paved_pref 0 then ( if is_smooth then add 1 multiply sub 0 paved_pref 0.15 else 1 )
       else 1

assign costfactor =
       if not footaccess then 100000
       else multiply surface_f
            max 1.0 sub add base_cost multiply noise_weight noise_s route_disc

assign turncost    = turn_cost
assign initialcost = 0

---context:node

assign footaccess_n =
       if foot=no|private then false
       else if foot=yes|designated|permissive then true
       else not access=no|private

assign initialcost =
       if not footaccess_n then 1000000
       else if or highway=traffic_signals crossing=traffic_signals then signal_cost
       else if crossing=zebra|marked then zebra_cost
       else if estimated_crossing_class=6 then multiply crossing_unit 6
       else if estimated_crossing_class=5 then multiply crossing_unit 5
       else if estimated_crossing_class=4 then multiply crossing_unit 4
       else if estimated_crossing_class=3 then multiply crossing_unit 3
       else if estimated_crossing_class=2 then multiply crossing_unit 2
       else if estimated_crossing_class=1 then crossing_unit
       else 0
